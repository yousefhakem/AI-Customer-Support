# Local dev: copy to .env.local.
# On Vercel, NEXT_PUBLIC_CONVEX_URL is filled in by `convex deploy`; set CONVEX_DEPLOY_KEY instead.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public URL of the widget app; used in the embed snippets shown on the Integrations page
NEXT_PUBLIC_WIDGET_URL=http://localhost:3001

# Optional: Sentry is disabled when the DSN is empty
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
